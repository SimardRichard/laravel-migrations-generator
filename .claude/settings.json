{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
      "defaultMode": "bypassPermissions",
      "additionalDirectories": ["/var/www", "/etc"],
      "allow": [],
      "deny": [
        "Bash(rm -rf /)",
        "Bash(rm -rf /*)",
        "Bash(git push --force *)",
        "Bash(git push -f *)",
        "Bash(git reset --hard *)"
      ]
    }
  }
